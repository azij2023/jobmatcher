{
  "version": 2,
  "name": "targetmatch-ai",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data.(json|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=60"
        }
      ]
    }
  ]
}

